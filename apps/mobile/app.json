{
  "expo": {
    "name": "이음로그",
    "slug": "ieumlog-student",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ieumlog",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "kr.ieumlog.student"
    },
    "ios": {
      "bundleIdentifier": "kr.ieumlog.student"
    },
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    }
  }
}
